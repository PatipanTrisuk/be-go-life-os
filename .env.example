APP_PORT=8080
# Use a random string of at least 32 characters (API refuses the example default).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=go_db
DB_SSLMODE=disable

# Rate limiting (per client IP)
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_BURST=5

# Login lockout after wrong password
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=60

# Optional overrides for `go run ./cmd/seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!

# Frontend base URL used in password-reset emails
FRONTEND_URL=http://localhost:3000
APP_NAME=LIFE+

# Require verified email before password login (true/false). Default: true
REQUIRE_EMAIL_VERIFICATION=true

# Discord OAuth (https://discord.com/developers/applications)
# Redirect URI must match the Next.js callback exactly, e.g.
# http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Brevo transactional email (recommended)
# 1) Create account: https://www.brevo.com/
# 2) Create an API key: https://app.brevo.com/settings/keys/api
# 3) Verify a sender: https://app.brevo.com/senders/domain/list
# If BREVO_API_KEY is set, the API is used and SMTP below is ignored.
BREVO_API_KEY=
SMTP_FROM=you@your-verified-domain.com
SMTP_FROM_NAME=LIFE+

# Optional Brevo SMTP fallback (only used when BREVO_API_KEY is empty)
# SMTP login/key: https://app.brevo.com/settings/keys/smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-smtp-login
# SMTP_PASSWORD=your-brevo-smtp-key

