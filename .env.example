APP_PORT=8080
# Use a random string of at least 32 characters (API refuses the example default).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=go_db
DB_SSLMODE=disable

# Rate limiting (per client IP)
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_BURST=5

# Login lockout after wrong password
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=60

# Optional overrides for `go run ./cmd/seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!

# Frontend base URL used in password-reset emails
FRONTEND_URL=http://localhost:3000
APP_NAME=Auth App

# Require verified email before password login (true/false). Default: true
REQUIRE_EMAIL_VERIFICATION=true

# Discord OAuth (https://discord.com/developers/applications)
# Redirect URI must match the Next.js callback exactly, e.g.
# http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Gmail SMTP (optional — if username/password empty, emails are logged to the API console)
# 1) Enable 2-Step Verification on the Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste Gmail + 16-char app password below (spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=you@gmail.com
